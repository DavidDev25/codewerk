# Kopiere diese Datei nach ".env" und trage deine Werte ein:   cp .env.example .env

# --- KI-Tutor (OmniRoute) --------------------------------------------------
# Adresse von OmniRoute, von INNEN im Container gesehen.
# host.docker.internal = dein Server selbst. 20128 ist der Standard-Port von OmniRoute.
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
# Dein API-Key aus OmniRoute. Er bleibt auf dem Server und gelangt nie in den Browser.
OMNIROUTE_API_KEY=
# Name des Modells (oder der Kombination), wie es in OmniRoute heißt, z. B. meine-combo
OMNIROUTE_MODEL=

# --- Passwortschutz (optional, aber empfohlen, wenn der Server aus dem Netz erreichbar ist) ---
# Leer lassen = kein Passwort. Sonst fragt der Browser nach Benutzer und Passwort.
BASIC_AUTH_USER=lernen
BASIC_AUTH_PASSWORD=

# --- Anschluss ---------------------------------------------------------------
# Unter diesem Port erreichst du Codewerk im Browser: http://SERVER:3000
PORT=3000
