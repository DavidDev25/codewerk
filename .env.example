# Kopiere diese Datei nach ".env" und trage deine Werte ein:   cp .env.example .env

# --- KI-Tutor (Cloudflare Workers AI, kostenloses Tageskontingent) ------------
# Leer lassen = kein Tutor, alles andere funktioniert trotzdem.
# Account-ID: im Cloudflare-Dashboard rechts unter "Account details" bzw. in der Adresszeile.
CLOUDFLARE_ACCOUNT_ID=
# API-Token mit genau einer Berechtigung: "Workers AI" (Lesen). Bleibt auf dem Server.
CLOUDFLARE_API_TOKEN=
# Modelle in Reihenfolge (fällt eins aus, kommt das nächste). Leer = Standard:
# @cf/mistralai/mistral-small-3.1-24b-instruct,@cf/qwen/qwen2.5-coder-32b-instruct
TUTOR_MODELS=

# --- Schutz des KI-Tutors (wichtig, wenn Codewerk öffentlich erreichbar ist) ---
# Höchstens so viele Tutor-Anfragen pro Minute und IP-Adresse:
TUTOR_LIMIT_PER_MINUTE=15
# Höchstens so viele Tutor-Anfragen pro Tag und IP-Adresse:
TUTOR_LIMIT_PER_DAY=50
# Läuft ein Reverse-Proxy davor (nginx, Caddy, Traefik)? Dann hier die Anzahl der
# Proxys eintragen (meist 1). Sonst sehen die Limits nur die IP des Proxys und
# würden für ALLE Besucher gemeinsam gelten. Ohne Proxy: leer lassen.
TRUST_PROXY=

# --- Passwortschutz (optional, aber empfohlen, wenn der Server aus dem Netz erreichbar ist) ---
# Leer lassen = kein Passwort. Sonst fragt der Browser nach Benutzer und Passwort.
BASIC_AUTH_USER=lernen
BASIC_AUTH_PASSWORD=

# --- Anmeldung mit GitHub (optional) ------------------------------------------
# Leer lassen = persönlicher Modus: eine Person, kein Login, Fortschritt in data/progress.json.
# Ausgefüllt = Konten-Modus: Gäste lernen sofort los (Fortschritt im Browser),
# mit GitHub-Anmeldung gibt es ein Konto mit gespeichertem Fortschritt und den KI-Tutor.
# Werte aus deiner GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Öffentliche Adresse von Codewerk, genau wie im Browser (ohne / am Ende).
# Daraus ergibt sich die Rückruf-Adresse für GitHub: <PUBLIC_URL>/auth/github/callback
# Beginnt sie mit https://, werden die Anmelde-Cookies nur verschlüsselt übertragen.
PUBLIC_URL=http://localhost:3000

# --- Anschluss ---------------------------------------------------------------
# Unter diesem Port erreichst du Codewerk im Browser: http://SERVER:3000
PORT=3000
